<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit1051 asks for the test cancellation token on every store call; the fixture stops the container and the calls are short. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DWIS.Semantic.Store/DWIS.Semantic.Store.csproj" />
    <PackageReference Include="Testcontainers" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
